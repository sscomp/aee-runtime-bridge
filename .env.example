# AEE Runtime Bridge environment variables
# Copy to .env and edit before running.
# Last revised: 2026-07-07 — multi-key auth (HERMES/BRIDGE/GPT/CLAUDE/CURSOR/MCP)

# Network binding for the bridge itself
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

# -----------------------------------------------------------------------------
# Client bridge keys — present one of these as  Authorization: Bearer ***
# -----------------------------------------------------------------------------
# The bridge accepts ANY of the following 5 keys, each with its own blast
# radius. To rotate a single key, overwrite its env var and restart the bridge
# (sudo supervisorctl restart hermes-runtime-bridge). Other keys stay valid.
#
#   BRIDGE_API_KEY        : CLI / CI / Integration Test
#   GPT_BRIDGE_API_KEY    : ChatGPT Custom GPT Action
#   CLAUDE_BRIDGE_API_KEY : future Claude integration
#   CURSOR_BRIDGE_API_KEY : future Cursor integration
#   MCP_BRIDGE_API_KEY    : future MCP client
#
# Generate a fresh key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=change-me-bridge-key
GPT_BRIDGE_API_KEY=change-me-gpt-key
CLAUDE_BRIDGE_API_KEY=change-me-claude-key
CURSOR_BRIDGE_API_KEY=change-me-cursor-key
MCP_BRIDGE_API_KEY=change-me-mcp-key

# -----------------------------------------------------------------------------
# Upstream Hermes M2 — bridge → 127.0.0.1:8642
# -----------------------------------------------------------------------------
# HERMES_API_KEY is machine-internal: the bridge presents it to /v1/runs on
# the caller's behalf. NEVER share it with external clients.
# (Source of truth: ~/.hermes/.env  API_SERVER_KEY  — kept in sync manually.)
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me-hermes-key

# Default session_id used when a caller does not provide one.
DEFAULT_SESSION_ID=dingde-orchestrator

# Optional: comma-separated list of allowed session_id prefixes.
# If empty, all session ids are accepted (still authenticated).
ALLOWED_SESSION_PREFIXES=

# -----------------------------------------------------------------------------
# MiniMax-M3 routing (added 2026-07-09)
# -----------------------------------------------------------------------------
# When a request authenticates with GPT_BRIDGE_API_KEY, the bridge forces
# the upstream model to MiniMax-M3 (per /home/ubuntu/Abacus/MiniMax-M3-routellm.md).
# Other sources (BRIDGE_API_KEY, CLAUDE_BRIDGE_API_KEY, etc.) keep their
# default / caller-supplied model.
#
# Generate / look up the key in the Abacus dashboard:
#   https://abacus.ai/help/developer-platform/route-llm
MINIMAX_API_KEY=set-***-in-your-local-env-only

# Base URL for the Abacus RouteLLM OpenAI-compatible gateway.
# Do not change unless Abacus rotates the endpoint.
MINIMAX_BASE_URL=https://routellm.abacus.ai/v1

# Full model id. The short name `minimax` or `minimax-m3` is rejected
# with HTTP 400 by the upstream — keep this exact value.
MINIMAX_MODEL=MiniMaxAI/MiniMax-M3

# If "true", a GPT caller's explicit `model_name` field wins over the
# forced MiniMax-M3 routing. Default "false" — the routing rule is
# that GPT ALWAYS uses MiniMax-M3.
MINIMAX_ALLOW_CALLER_OVERRIDE=false

# Default model for non-GPT sources when the caller did not pass one.
# Mirrors ~/.hermes/config.yaml model.default.
BRIDGE_DEFAULT_MODEL=minimax-m3

