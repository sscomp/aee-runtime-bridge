# AEE-4 Part B — Pi Worker systemd reference unit
#
# The Abacus.AI host uses supervisord (PID 7), NOT systemd.
# This file is a reference for hosts that do use systemd
# (developer laptops, other deployments). See
# pi-agent/supervisor/pi-agent.conf for the production unit.
#
# Install (one-time, on a systemd host):
#   1. Copy to /etc/systemd/system/pi-agent.service
#   2. Ensure the bridge is also a systemd unit
#      (hermes-runtime-bridge.service)
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now pi-agent
#
# Logs:
#   journalctl -u pi-agent -f

[Unit]
Description=AEE-4 Part B — Pi Worker daemon (Agent Execution Engine)
Documentation=file:///home/ubuntu/hermes-runtime-bridge/pi-agent/README.md
After=network-online.target hermes-runtime-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hermes-runtime-bridge
ExecStart=/home/ubuntu/hermes-runtime-bridge/.venv/bin/python \
    -u \
    /home/ubuntu/hermes-runtime-bridge/pi-agent/pi_worker.py \
    --config /home/ubuntu/hermes-runtime-bridge/pi-agent/config.yaml
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=300
# Give the daemon time to flush the final heartbeat and call
# /v1/jobs/{id}/fail on SIGTERM. The runtime's per-job timeout
# is 900s; a job still running after 15s gets force-killed and
# the bridge reaper reaps it to `timeout`.
TimeoutStopSec=15
# Hardening: refuse setuid, drop capabilities we don't need.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/ubuntu/hermes-runtime-bridge/runtime_data/pi-agent
# /home/ubuntu is read-only; the daemon's workdirs live under
# runtime_data/pi-agent, which is the only writable path.

[Install]
WantedBy=multi-user.target
