# AEE-4 Part B — Pi Worker provider env file (template).
#
# Copy to `provider.env` and `chmod 600`. The daemon refuses to
# start if PI_PROVIDER_API_KEY is a placeholder value.
#
# The base URL, API key, and model are passed to the node
# runtime's process env, which uses them to call an
# OpenAI-compatible chat completions endpoint.
#
# OpenAI:        https://api.openai.com/v1
# OpenRouter:    https://openrouter.ai/api/v1
# Anthropic:     https://api.anthropic.com/v1 (use a proxy
#                that speaks OpenAI's API; the openai SDK
#                expects chat.completions/create)
# Ollama local:  http://127.0.0.1:11434/v1 (no real key needed
#                but the field is required; use "ollama")

PI_PROVIDER_BASE_URL=https://api.openai.com/v1
PI_PROVIDER_API_KEY=sk-REPLACE-ME
PI_PROVIDER_MODEL=gpt-4o-mini

# Optional: identify the runtime family + version to the bridge
# in the worker metadata. Defaults are "pi" / "0.1.0" if unset.
# PI_PROVIDER_RUNTIME_NAME=pi
# PI_PROVIDER_RUNTIME_VERSION=0.1.0
