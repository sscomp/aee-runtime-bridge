# AEE MCP gateway — profile: OS-NATIVE (default general-purpose install)
#
# Contract: config/profiles/profile-schema.json · docs/deployment-profiles.md
# Install:  scripts/install-aee-gateway.sh --profile os-native --check
#
# Placeholders (<...>) MUST be replaced by the operator on the target host.
# Real secret values live only in this operator-owned file (0600) and never
# in Git, receipts or logs. Never copy credential material from another host.

# --- transport boundary (fixed) ------------------------------------------
AEE_MCP_HOST=127.0.0.1
AEE_MCP_PORT=8791
AEE_MCP_SURFACE=restricted
AEE_MCP_REQUIRE_AUTH=true

# --- gateway authentication key (secret; operator-provisioned, 0600 file) -
MCP_BRIDGE_API_KEY=<provision-private-mcp-key>

# --- profile identity (reported by aee_status gateway diagnostics) --------
AEE_DEPLOYMENT_PROFILE=os-native

# --- mutable state (operator-chosen absolute dir, 0700, owned by the
#     service OS identity) --------------------------------------------------
A3_JOB_STORE_DIR=<operator-state-dir>/jobs

# --- trusted dispatch (OPTIONAL but required for trusted write/autonomous;
#     provision WITH scripts/provision-trusted-dispatch.py which creates the
#     0600 policy and validates it fail-closed) -----------------------------
# AEE_TRUSTED_DISPATCH_POLICY=$HOME/.config/aee/trusted-dispatch-policy.json

# --- execution budget (optional) -----------------------------------------
# AEE_EXECUTION_POLICY=$HOME/.config/aee/execution-budget.json

# --- adapter discovery (OPTIONAL overrides; absolute executable paths.
#     Without these the gateway resolves default executable names on its
#     own service PATH. Discovery results and reasons are surfaced by
#     aee_agents) -----------------------------------------------------------
# A3_ADAPTER_CODEX_BIN=<absolute-executable-path>
# A3_ADAPTER_CLAUDE_BIN=<absolute-executable-path>
# A3_ADAPTER_HERMES_BIN=<absolute-executable-path>
# A3_ADAPTER_PI_BIN=<absolute-executable-path>
# A3_CODEX_BIN=<absolute-executable-path>

# --- optional explicit confinement (OFF by default on os-native).
#     Unsetting/omitting means: no workspace-root allowlist; access is
#     decided by the executor identity's OS permissions.
# A3_DISPATCH_ALLOWED_ROOTS=<optional-explicit-root-list>

# --- model provider presentation (secrets; host-owned) --------------------
# ANTHROPIC_BASE_URL=<provider-url>
# ANTHROPIC_AUTH_TOKEN=<provider-token>
# ANTHROPIC_MODEL=<model-id>