# AEE MCP gateway — profile: RESTRICTED (explicit opt-in hardened install)
#
# Contract: config/profiles/profile-schema.json · docs/deployment-profiles.md
# This profile preserves the dedicated-account P2C deployment shape: broker +
# workspace snapshot + deployment manifests + ProtectHome/ProtectSystem
# sandbox + explicit workspace-root confinement. Select it ONLY when the
# hardened service model is the requirement; the default general-purpose
# profile is os-native (see os-native.env.example).
#
# System units require root: the installer stages artifacts and prints the
# exact operator commands; it never acquires privileges itself.

# --- transport boundary (fixed) ------------------------------------------
AEE_MCP_HOST=127.0.0.1
AEE_MCP_PORT=8791
AEE_MCP_SURFACE=restricted
AEE_MCP_REQUIRE_AUTH=true

# --- gateway authentication key (secret; operator-provisioned) ------------
MCP_BRIDGE_API_KEY=<provision-private-restricted-key>

# --- profile identity ------------------------------------------------------
AEE_DEPLOYMENT_PROFILE=restricted

# --- explicit confinement (REQUIRED on restricted) -------------------------
A3_DISPATCH_ALLOWED_ROOTS=<confinement-root-list>

# --- AEE-owned state --------------------------------------------------------
A3_JOB_STORE_DIR=<AEE-owned-state-dir>/jobs

# --- codex production broker contract --------------------------------------
A3_CODEX_BIN=<immutable-release-absolute-path>/runner/codex
A3_WORKSPACE_MANIFEST=<immutable-release-absolute-path>/workspace-manifest.json
AEE_RUNTIME_MANIFEST=<immutable-release-absolute-path>/deployment-manifest.json
AEE_BROKER_CONTROL=/run/aee-broker/control.sock