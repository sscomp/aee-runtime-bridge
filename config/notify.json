{
  "telegram": {
    "enabled": true,
    "bot_token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_CHAT_ID",
    "notify_on": [
      "failed",
      "timeout",
      "completed",
      "cancelled"
    ],
    "rate_limit_per_hour": 20
  },
  "enforcement_gate": {
    "version": "v3.0.0",
    "primary_path": "hermes_send",
    "fallback_path": "notifier.notify_completed",
    "blocking": false
  }
}