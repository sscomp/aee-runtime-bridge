# UNINSTALLED P2C candidate; retain exact reviewed tunnel-facing MCP key locally.
MCP_BRIDGE_API_KEY=<provision-private-restricted-key>
AEE_MCP_HOST=127.0.0.1
AEE_MCP_PORT=8791
AEE_MCP_SURFACE=restricted
AEE_MCP_REQUIRE_AUTH=true
AEE_MCP_EXPOSED_TOOLS=aee_status,aee_agents,aee_dispatch,aee_job_status,aee_job_result
AEE_MCP_ALLOWED_ROOTS=/opt/aee/current/source
A3_DISPATCH_ALLOWED_ROOTS=/opt/aee/current/source
A3_JOB_STORE_DIR=/var/lib/aee/jobs
A3_CODEX_BIN=<immutable-release-absolute-path>/runner/codex
A3_WORKSPACE_MANIFEST=/opt/aee/current/workspace-manifest.json
AEE_RUNTIME_MANIFEST=/opt/aee/current/deployment-manifest.json
AEE_BROKER_CONTROL=/run/aee-broker/control.sock
A3_EXECUTION_PROFILE=codex-readonly-high
A3_CODEX_TIMEOUT_SEC=900
