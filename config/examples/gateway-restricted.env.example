# Placeholders only. Explicit A3 five-tool restricted surface.
MCP_BRIDGE_API_KEY=<set-locally>
AEE_MCP_HOST=127.0.0.1
AEE_MCP_PORT=8791
AEE_MCP_SURFACE=restricted
AEE_MCP_REQUIRE_AUTH=true
AEE_MCP_EXPOSED_TOOLS=aee_status,aee_agents,aee_dispatch,aee_job_status,aee_job_result
AEE_MCP_ALLOWED_ROOTS=<absolute-home-path>,/tmp
A3_DISPATCH_ALLOWED_ROOTS=<absolute-repository-path>
A3_JOB_STORE_DIR=<absolute-private-shared-job-store-path>
A3_CODEX_BIN=<absolute-reviewed-native-codex-ELF-path>
A3_WORKSPACE_MANIFEST=<absolute-private-reviewed-manifest-path>
A3_EXECUTION_PROFILE=codex-readonly-high
A3_CODEX_TIMEOUT_SEC=900
