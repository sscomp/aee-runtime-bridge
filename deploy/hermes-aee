#!/usr/bin/env python3
from importlib.machinery import PathFinder
from importlib.util import find_spec
import runpy
import sys
from pathlib import Path

# The gateway probes chat --help before permitting autonomous execution.
# Check the selected interpreter without importing Hermes or loading its profile.
package = find_spec("hermes_cli")
if (package is None or not package.submodule_search_locations
        or find_spec("run_agent") is None
        or any(PathFinder.find_spec(f"hermes_cli.{name}", package.submodule_search_locations) is None
               for name in ("main", "config", "oneshot"))):
    sys.exit("hermes-aee requires a compatible Hermes installation on the gateway Python path")

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
runpy.run_module('aee.mcp_runtime.hermes_oneshot', run_name='__main__')
