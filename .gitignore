# =====================================================================
# hermes-runtime-bridge / Agent Execution Engine (AEE) — .gitignore
# Generated for AEE-0 baseline hardening (2026-07-10)
#
# Layered rules:
#   1) secrets / credentials (NEVER commit)
#   2) runtime data (DB, logs, reports, .venv)
#   3) build / tooling artifacts
#   4) local-only convenience
# =====================================================================

# ---------- 1. Secrets / credentials ----------
.env
.env.*
!.env.example
.api_keys.vault.json
**/.api_keys.vault.json
CREDENTIALS.txt
**/CREDENTIALS.txt
*.pem
*.key
*.p12
secrets/
private/

# ---------- 2. Runtime data ----------
# SQLite DBs (WAL + SHM sidecar)
data/*.db
data/*.db-*
data/*.db-journal
data/*.db-wal
data/*.db-shm
# Local-only runtime_data (introduced in AEE-0)
runtime_data/
# Logs
logs/
*.log
# Per-task reports
reports/TASK-*/
# Backups
*.bak.*
*.bak-*
data.bak.*/

# ---------- 3. Build / tooling artifacts ----------
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
dist/
build/
node_modules/

# ---------- 4. Local-only convenience ----------
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~
.tmp_*.py
